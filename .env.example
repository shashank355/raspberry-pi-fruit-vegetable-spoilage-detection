# ==============================================================================
# FreshScan AI 2.0 — Environment Configuration
# ==============================================================================

# MQTT Broker (Raspberry Pi Mosquitto)
MQTT_ENABLED=true
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=freshscan_pi_controller

# Telegram Bot Notifications (from @BotFather)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.70

# Camera Resolution
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=20
CAMERA_INDEX=0
