# ==============================================================================
# FreshScan AI 2.0 — Environment Configuration (Raspberry Pi 5)
# ==============================================================================

# MQTT Broker (Raspberry Pi Mosquitto)
MQTT_ENABLED=true
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=freshscan_pi5_controller

# Telegram Bot Notifications (from @BotFather)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# AI Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.70

# External USB Camera Settings (Raspberry Pi 5)
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=20
# CAMERA_INDEX='auto' automatically selects connected external USB cameras (e.g. /dev/video2)
CAMERA_INDEX=auto

# Gemini AI Pro Multimodal Quality Inspection & Token Guard
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUTO_INTERVAL=15.0
GEMINI_COOLDOWN=10.0
GEMINI_FRAME_DIFF_THRESHOLD=10.0
GEMINI_MAX_IMAGE_DIM=512
